Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Global Options:
    Fixed Frame: odom
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /odom
      Keep: 500
      Position Tolerance: 0.02
      Angle Tolerance: 0.05
      Shape:
        Shaft Length: 0.2
        Shaft Radius: 0.03
        Head Length: 0.08
        Head Radius: 0.06
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDown
      Scale: 120
      Target Frame: odom
